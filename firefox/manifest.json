{
  "manifest_version": 3,
  "name": "DeepSeek Pilot",
  "version": "0.9.0",
  "description": "为 DeepSeek 网页版加入项目管理、个人与项目记忆、长会话接续。",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "action": {
    "default_popup": "options/options.html"
  },
  "options_page": "options/options.html",
  "background": {
    "scripts": [
      "logic/db.js",
      "background/session-memory.js",
      "background/workbench.js"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logic/request-body-core.js",
        "page/page-network.js"
      ],
      "matches": [
        "https://chat.deepseek.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "logic/request-body-core.js",
        "page/page-network.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "css": [
        "content/workbench.css"
      ],
      "js": [
        "logic/history-core.js",
        "logic/memory-display.js",
        "ui.js",
        "content/workbench.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "deepseek-pilot@5j-5j.github.io",
      "strict_min_version": "128.0"
    }
  }
}
