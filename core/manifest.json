{
  "manifest_version": 3,
  "name": "DeepSeek 项目工作台",
  "version": "0.9.0",
  "description": "DeepSeek 项目树、会话归类、项目记忆与长会话接续。",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "action": {
    "default_popup": "options/options.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/workbench.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["logic/request-body-core.js", "page/page-network.js"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "css": ["content/workbench.css"],
      "js": ["logic/history-core.js", "content/workbench.js"],
      "run_at": "document_start"
    }
  ]
}
