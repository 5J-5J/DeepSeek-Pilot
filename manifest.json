{
  "manifest_version": 3,
  "name": "DeepSeek 任务工作台",
  "version": "0.6.1",
  "description": "用任务组织 DeepSeek 会话，在右侧详情栏维护进度、任务记忆和用户事实。",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["request-body-core.js", "page-network.js"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "css": ["content.css"],
      "js": ["memory-core.js", "history-core.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
